---
import MazeApp from '../components/MazeApp';
import SiteIcons from '../components/SiteIcons.astro';
import '../styles/maze.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<SiteIcons />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>the maze</title>
	</head>
	<body>
		<MazeApp client:only="preact" />
		<noscript>
			<p
				style="min-height:100dvh;margin:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:2rem;color:var(--text);background:var(--bg);font-family:var(--font-mono);letter-spacing:0.04em;"
			>
				the maze needs javascript to find its way. enable it to enter.
			</p>
		</noscript>
	</body>
</html>
