---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Toc from '../../components/Toc.astro';
import TagList from '../../components/TagList.astro';
import Comments from '../../components/Comments.astro';
import { getPublishedPosts, isCjkPost } from '../../lib/posts';
import { formatDate } from '../../lib/date';
import { hasCjk } from '../../lib/cjk';
import { hasMath } from '../../lib/math';
import { readingTime } from '../../lib/reading-time';

export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content, headings } = await render(post);
const cjk = hasCjk((post.body ?? '') + ' ' + (post.data.description ?? ''));
const math = hasMath(post.body ?? '');

// Table of contents: only when there are 3+ section headings (h2/h3), matching
// the outline the Toc component builds. Below that threshold a TOC is noise.
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = tocHeadings.length >= 3;
---

<Layout title={post.data.title} lang={post.data.lang} cjk={cjk} math={math} wide={showToc}>
	<div class="post-layout">
		{showToc && (
			<aside class="toc-sidebar">
				<Toc headings={tocHeadings} />
			</aside>
		)}
		{/* data-pagefind-body scopes Pagefind's index to post articles only, so
		    search never returns nav chrome or non-blog pages (see /blog/search).
		    CJK posts are excluded — they're handled by substring search instead
		    (see /blog/search-cjk.json), because Pagefind's word+prefix matching
		    hides mid-word CJK characters. isCjkPost is the shared partition. */}
		<article data-pagefind-body={!isCjkPost(post) ? true : undefined}>
			<h1>{post.data.title}</h1>
			{/* The frontmatter description as a standfirst under the title. It's real
			    page text inside the indexed region, so it's searchable too (a word
			    that lives only in the description would otherwise never match). */}
			{post.data.description && <p class="lede">{post.data.description}</p>}
			{/* Ignored for full-text: the date/reading-time is chrome, not prose, and
			    would otherwise lead short posts' search excerpts. data-pagefind-meta
			    still exposes the date for the result line. */}
			<p class="meta" data-pagefind-ignore>
				<time datetime={post.data.pubDate.toISOString()} data-pagefind-meta="date">
					{formatDate(post.data.pubDate)}
				</time>
				<span class="reading-time"> · {readingTime(post.body ?? '')}</span>
				{post.data.updatedDate && (
					<span class="updated">
						{' '}(updated <time datetime={post.data.updatedDate.toISOString()}>
							{formatDate(post.data.updatedDate)}
						</time>)
					</span>
				)}
			</p>
			{/* Tags stay indexable (no data-pagefind-ignore) so searching a topic word
			    finds posts tagged with it — they only surface in an excerpt when the
			    query actually matches one. */}
			<TagList tags={post.data.tags} />
			{showToc && (
				<details class="toc-disclosure" data-pagefind-ignore>
					<summary>Contents</summary>
					<Toc headings={tocHeadings} />
				</details>
			)}
			<Content />
		</article>
	</div>
	{/* Comments sit below the article, centered on the reading measure regardless
	    of the TOC grid (see .comments in content.css). Opt out per post with
	    `comments: false` in frontmatter. */}
	{post.data.comments && <Comments lang={post.data.lang} />}
</Layout>
