---
import Layout from '../../layouts/Layout.astro';
import BlogSearch from '../../components/BlogSearch';
---

<Layout title="Search">
	<h1>Search</h1>
	<p class="blog-nav">
		<a href="/blog">← All posts</a>
		<span aria-hidden="true"> · </span>
		<a href="/blog/tags">Tags</a>
	</p>
	{/* The one interactive island on the content side. Pagefind indexes only post
	    articles (data-pagefind-body), so results are blog posts only. */}
	<BlogSearch client:load />
	<noscript>
		<p>Search needs JavaScript. Browse <a href="/blog/tags">by tag</a> or the
		<a href="/blog">full list</a> instead.</p>
	</noscript>
</Layout>
