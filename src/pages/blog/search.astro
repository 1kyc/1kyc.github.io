---
import Layout from '../../layouts/Layout.astro';
import BlogSearch from '../../components/BlogSearch';
import { getPublishedPosts, isCjkPost } from '../../lib/posts';

// If any CJK posts exist, load the CJK fonts so Chinese/Japanese result titles
// and excerpts render in their own faces.
const cjk = (await getPublishedPosts()).some(isCjkPost);
---

<Layout title="Search" cjk={cjk}>
	<h1>Search</h1>
	<p class="blog-nav">
		<a href="/blog">← All posts</a>
		<span aria-hidden="true"> · </span>
		<a href="/blog/tags">Tags</a>
	</p>
	{/* The one interactive island on the content side: Pagefind for English posts,
	    substring search for CN/JP posts (see BlogSearch). */}
	<BlogSearch client:load />
	<noscript>
		<p>Search needs JavaScript. Browse <a href="/blog/tags">by tag</a> or the
		<a href="/blog">full list</a> instead.</p>
	</noscript>
</Layout>
