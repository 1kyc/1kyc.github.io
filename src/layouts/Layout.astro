---
import '../styles/content.css';

// Reading typeface: self-hosted Noto Sans via Fontsource. The Latin variable
// face is global; the heavy CJK statics (zh-Hans / ja) load conditionally via
// <CjkFonts>, only on pages whose content actually contains CJK. All
// @font-face only; no JS.
import '@fontsource-variable/noto-sans/index.css';

import CjkFonts from '../components/CjkFonts.astro';
import KatexStyles from '../components/KatexStyles.astro';

import { AUTHOR, LICENSE_URL, REPO_URL } from '../lib/site';

// Stamped at BUILD time, so the footer's year advances with each deploy without
// shipping a line of JS to compute it.
const year = new Date().getFullYear();

interface Props {
	title: string;
	lang?: string;
	cjk?: boolean;
	// Load the self-hosted KaTeX stylesheet — only on pages whose content contains
	// math (see <KatexStyles>). Conditional so math-free pages ship none of it.
	math?: boolean;
	// Widen <main> to make room for a beside-the-article TOC sidebar (the reading
	// column itself stays at --measure; see content.css). Only blog posts with a
	// rendered TOC opt in — every other page keeps the plain centered column.
	wide?: boolean;
}

const { title, lang = 'en', cjk = false, math = false, wide = false } = Astro.props;

// Normalize the current path (drop any trailing slash) so section matching is
// stable regardless of trailingSlash config.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// A nav link is "current" when the path is its own page or nested beneath it
// (so `/blog` lights up on both `/blog` and `/blog/<slug>`). The `${href}/`
// guard keeps `/blog` from matching a sibling like `/blogfoo`.
const isActive = (href: string) =>
	path === href || path.startsWith(`${href}/`);
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		{/* No-FOUC: set the theme attribute BEFORE the body paints so the correct
		    palette + toggle icon render on first frame. is:inline keeps it
		    synchronous/blocking (Astro won't bundle or defer it); the try/catch
		    guards private-mode localStorage throwing. */}
		<script is:inline>
			try {
				var t = localStorage.getItem('theme');
				if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
			} catch (e) {}
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="alternate" type="application/rss+xml" title="1kyc — Blog" href="/rss.xml" />
		<title>{title}</title>
		{cjk && <CjkFonts />}
		{math && <KatexStyles />}
	</head>
	<body>
		{/* The maze guards ONLY the landing/root — it isolates that one page.
		    Content pages (the blog especially) are meant to be openly
		    discoverable and indexable, so their nav is plaintext by design.
		    Keep this in the clear; only the root is hidden behind the maze. */}
		<nav>
			<a href="/home" aria-current={isActive('/home') ? 'page' : undefined}>Home</a>
			<a href="/blog" aria-current={isActive('/blog') ? 'page' : undefined}>Blog</a>
			<a href="/projects" aria-current={isActive('/projects') ? 'page' : undefined}>Projects</a>
			<a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
			<button type="button" class="theme-toggle" aria-label="Switch color theme">
				<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
				</svg>
				<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
				</svg>
			</button>
		</nav>
		{/* Pagefind: a page with no data-pagefind-body is indexed in full, so with
		    zero published posts the whole site (incl. the maze root) would leak into
		    search. Ignore <main> by default; the post page re-includes its <article>
		    with data-pagefind-body, which overrides this ancestor ignore. Net: only
		    post articles are ever indexed, in every state. */}
		<main class:list={{ wide }} data-pagefind-ignore>
			<slot />
		</main>
		{/* Site footer — the quiet, always-there half of the nav. Everything here is
		    reference material rather than a destination, which is exactly why none
		    of it belongs in the top nav:
		      RSS      the feed exists but is otherwise only a <link> in <head>,
		               i.e. findable by readers' software and by nobody else.
		      Source   the site is its own repo; it also makes /privacy checkable.
		      Privacy  the transparency notice (GDPR Art. 13) — a notice nobody can
		               find isn't one, so it needs a home on every page.
		    A plain <div>, NOT a <nav>: content.css styles the `nav` element itself
		    (section 3), so a second one here would inherit the top bar's rule and
		    padding. */}
		<footer>
			<p class="footer-legal">
				© {year} {AUTHOR} · <a href={LICENSE_URL}>MIT</a>
			</p>
			<div class="footer-links">
				<a href="/rss.xml">RSS</a>
				<a href={REPO_URL}>Source</a>
				<a href="/privacy" aria-current={isActive('/privacy') ? 'page' : undefined}>Privacy</a>
			</div>
		</footer>
		{/* Toggle behavior. A bundled Astro <script> is an ES module = deferred,
		    so the DOM (and the button) is ready when it runs. The correct icon +
		    palette are already painted by the no-FOUC head script and the CSS
		    theme selectors; this only flips the choice and syncs the aria-label. */}
		<script>
			import { effectiveTheme, THEME_CHANGE_EVENT } from '../lib/theme';
			const btn = document.querySelector('.theme-toggle');
			if (btn) {
				const root = document.documentElement;
				const setLabel = () =>
					btn.setAttribute('aria-label', effectiveTheme() === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
				setLabel();
				btn.addEventListener('click', () => {
					const next = effectiveTheme() === 'dark' ? 'light' : 'dark';
					root.dataset.theme = next;
					try { localStorage.setItem('theme', next); } catch (e) {}
					setLabel();
					// Announce the flip so out-of-cascade consumers (e.g. the giscus
					// iframe) can react without spying on this DOM write.
					window.dispatchEvent(new CustomEvent(THEME_CHANGE_EVENT));
				});
			}
		</script>
	</body>
</html>
