---
import { GISCUS, commentsI18n } from '../lib/giscus';

interface Props {
	// Post language → giscus UI locale + localized heading, so the widget chrome
	// ("Sign in", "Write", …) and the section title match the post it sits under.
	lang?: string;
}
const { lang = 'en' } = Astro.props;
const { locale, heading } = commentsI18n(lang);
---

{/* Comments live OUTSIDE the article's data-pagefind-body (they're not our
    prose) and are explicitly ignored so a comment never leaks into post search.
    The static giscus config is imported straight into the client script from
    lib/giscus; only the per-post UI locale crosses the server→client boundary,
    via data-ui-lang. The script injects giscus only when the section scrolls
    into view (no giscus.app request until then). */}
<section class="comments" aria-labelledby="comments-heading" data-pagefind-ignore>
	<h2 id="comments-heading" class="comments-heading">{heading}</h2>
	<div class="giscus" data-giscus data-ui-lang={locale}></div>
	<noscript>
		<p class="comments-fallback">
			Comments are powered by GitHub Discussions and need JavaScript. You can
			read and reply in
			<a href={`https://github.com/${GISCUS.repo}/discussions`}>the discussions on GitHub</a>.
		</p>
	</noscript>
</section>

<script>
	import { GISCUS } from '../lib/giscus';
	import { effectiveTheme, THEME_CHANGE_EVENT } from '../lib/theme';

	// Lazy, privacy-first giscus loader. No third-party (giscus.app) request fires
	// until the reader scrolls the comments into view — a reader who never reaches
	// the bottom stays fully zero-third-party. Vanilla, not a framework island:
	// the sanctioned content-side exception alongside the theme toggle.
	const mount = document.querySelector<HTMLElement>('[data-giscus]');
	if (mount) {
		const ORIGIN = 'https://giscus.app';

		// giscus custom themes are a CSS URL it loads INSIDE its iframe. We ship two
		// self-hosted files (public/giscus/{light,dark}.css) mirroring the site
		// palette, resolved against the current origin so dev and prod each load
		// their own copy — no third-party theme host. effectiveTheme() is the
		// site's shared theme decision (see lib/theme).
		const themeUrl = () => new URL(`/giscus/${effectiveTheme()}.css`, location.origin).href;

		let loaded = false;
		const load = () => {
			if (loaded) return;
			loaded = true;
			const s = document.createElement('script');
			s.src = `${ORIGIN}/client.js`;
			s.async = true;
			s.crossOrigin = 'anonymous';
			s.setAttribute('data-repo', GISCUS.repo);
			s.setAttribute('data-repo-id', GISCUS.repoId);
			s.setAttribute('data-category', GISCUS.category);
			// Omit an empty category-id so giscus resolves the category by name.
			if (GISCUS.categoryId) s.setAttribute('data-category-id', GISCUS.categoryId);
			s.setAttribute('data-mapping', GISCUS.mapping);
			s.setAttribute('data-strict', '1');
			s.setAttribute('data-reactions-enabled', '1');
			s.setAttribute('data-emit-metadata', '0');
			s.setAttribute('data-input-position', 'top');
			s.setAttribute('data-theme', themeUrl());
			s.setAttribute('data-lang', mount.dataset.uiLang!);
			s.setAttribute('data-loading', 'lazy');
			// giscus renders its iframe into the .giscus container (this mount).
			mount.appendChild(s);
		};

		if ('IntersectionObserver' in window) {
			const io = new IntersectionObserver(
				(entries) => {
					if (entries.some((e) => e.isIntersecting)) {
						io.disconnect();
						load();
					}
				},
				{ rootMargin: '200px' },
			);
			io.observe(mount);
		} else {
			load();
		}

		// Keep the iframe's theme in sync with the site. postMessage no-ops until the
		// iframe exists (early flips are harmless — the initial data-theme paints the
		// right one). themeUrl()/effectiveTheme() encode the override-vs-OS precedence,
		// so every trigger can just re-send without re-checking it here.
		const syncTheme = () => {
			const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
			frame?.contentWindow?.postMessage(
				{ giscus: { setConfig: { theme: themeUrl() } } },
				ORIGIN,
			);
		};
		// Explicit toggle flips announce themselves; OS changes fire matchMedia.
		window.addEventListener(THEME_CHANGE_EVENT, syncTheme);
		matchMedia('(prefers-color-scheme: light)').addEventListener('change', syncTheme);
		// Reconcile once the widget mounts: if the reader toggled during the
		// sub-second load window, syncTheme() no-op'd (no iframe yet), so the initial
		// data-theme could be stale. Re-sync on the FIRST giscus message (its ready
		// signal), then unhook — later giscus messages (resize on every keystroke,
		// etc.) shouldn't keep re-pushing the theme. A plain `once` would be spent by
		// any stray postMessage, so remove only after a real giscus one.
		const reconcile = (e: MessageEvent) => {
			if (e.origin !== ORIGIN || !e.data?.giscus) return;
			syncTheme();
			window.removeEventListener('message', reconcile);
		};
		window.addEventListener('message', reconcile);
	}
</script>
